# ---------------------------------------------------------------------------
# Influential Minds API (apps/api)
# Copy to apps/api/.env and fill in real values. Never commit the filled file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# MySQL 8 connection string.
DATABASE_URL="mysql://influential:change-me@127.0.0.1:3306/influential_minds"

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Admin sessions --------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-this-with-a-long-random-value-min-32-chars
AUTH_COOKIE_NAME=im_admin_session
AUTH_SESSION_TTL_HOURS=12
# Must be true in production (HTTPS). Set to false for plain-HTTP local dev.
AUTH_COOKIE_SECURE=false
# Set when the API and site share a parent domain, e.g. .influentialminds.com
# AUTH_COOKIE_DOMAIN=

# Salt mixed into hashed IPs for Ask-the-Archive rate limiting.
IP_HASH_SALT=replace-this-with-a-random-salt

# --- Ask the Archive -------------------------------------------------------
# disabled  = the feature is hidden
# mock      = clearly labelled development answers, no external calls
# mindstudio = managed RAG provider
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.mindstudio.ai
AI_PROVIDER_AGENT_ID=
AI_PROVIDER_TIMEOUT_MS=25000
AI_MIN_SCORE=0.12
AI_MAX_SOURCES=5

# --- Media library ---------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_PATH=/media
STORAGE_MAX_UPLOAD_MB=25

# --- Seeding ---------------------------------------------------------------
# Used once by `pnpm db:seed` to create the first SUPER_ADMIN.
SEED_ADMIN_EMAIL=admin@influentialminds.local
SEED_ADMIN_PASSWORD=change-this-password-now
SEED_ADMIN_NAME=Influential Minds Admin
