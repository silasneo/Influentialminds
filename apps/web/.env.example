# ---------------------------------------------------------------------------
# Influential Minds web app (apps/web)
# Copy to apps/web/.env.local and adjust per environment.
# Both values are inlined into the browser bundle, so never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the NestJS API, without the /api/v1 suffix.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public URL of this site, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
