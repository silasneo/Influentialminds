{
  "name": "influential-minds",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @influential-minds/api dev",
    "dev:web": "pnpm --filter @influential-minds/web dev",
    "build": "pnpm --filter @influential-minds/contracts build && pnpm --filter @influential-minds/api build && pnpm --filter @influential-minds/web build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @influential-minds/api prisma:generate",
    "db:migrate": "pnpm --filter @influential-minds/api prisma:migrate",
    "db:deploy": "pnpm --filter @influential-minds/api prisma:deploy",
    "db:seed": "pnpm --filter @influential-minds/api prisma:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
